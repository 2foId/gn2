# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/guyub_ngapak?schema=public"

# JWT
JWT_ACCESS_SECRET="ganti-dengan-secret-acak-yang-panjang"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="ganti-dengan-secret-lain-yang-berbeda"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=3001
FRONTEND_URL="http://localhost:3000"
COOKIE_SECURE=false

# OTP
OTP_EXPIRES_IN_MINUTES=5

# ============================================================================
# Provider WhatsApp untuk kirim OTP — pilih salah satu: "stub" | "meta" | "fonnte"
# - stub   : tidak kirim sungguhan, kode OTP dicetak ke console log (default, dev only)
# - meta   : Meta WhatsApp Cloud API (resmi, butuh Business App + template approved)
# - fonnte : Fonnte (tidak resmi, setup cepat, populer untuk MVP di Indonesia)
# ============================================================================
WHATSAPP_PROVIDER=stub

# Isi HANYA jika WHATSAPP_PROVIDER=meta
# Ambil dari dashboard developers.facebook.com > App > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Isi HANYA jika WHATSAPP_PROVIDER=fonnte
# Ambil dari dashboard fonnte.com setelah hubungkan nomor WA
FONNTE_TOKEN=

# Webhook — WAJIB diisi untuk melewati form "Configure Webhooks" di Meta App
# Dashboard, meskipun aplikasi ini hanya kirim OTP satu arah (tidak menerima
# balasan). Buat string acak sendiri, isi juga persis sama di kolom
# "Verify token" pada dashboard Meta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=ganti-dengan-string-acak-buatan-sendiri

